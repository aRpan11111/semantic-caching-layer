  "panels": [
    {
      "type": "stat",
      "title": "Real-time Cache Hit Rate (%)",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(llm_cache_requests_total{status=\"hit\"}[5m])) / sum(rate(llm_cache_requests_total[5m])) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total LLM API Cost Saved ($ USD)",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(llm_cache_cost_saved_usd_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Tokens Saved",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(llm_cache_tokens_saved_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Response Latency Comparison (Cached vs. Uncached)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(llm_cache_latency_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "P50 Latency ({{status}})",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(llm_cache_latency_seconds_bucket[5m])) by (le, status))",
          "legendFormat": "P95 Latency ({{status}})",
          "refId": "B"
        }
      ]
    },
