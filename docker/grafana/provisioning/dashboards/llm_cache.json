{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Real-time Cache Hit Rate (%)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(llm_cache_requests_total{status=\"hit\"}[5m])) / sum(rate(llm_cache_requests_total[5m])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Cumulative Cost Savings ($)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(llm_cache_cost_saved_usd_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "fixedColor": "green", "mode": "fixed" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Tokens Served from Cache",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(llm_cache_tokens_saved_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "purple", "mode": "fixed" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Cache Size (Entries)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "llm_cache_entries_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency Percentiles: Cache Hit vs Miss (P50 / P95 / P99)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_cache_latency_seconds_bucket{status=\"hit\"}[5m])) by (le)) * 1000",
          "legendFormat": "Hit P95 (ms)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(llm_cache_latency_seconds_bucket{status=\"miss\"}[5m])) by (le)) * 1000",
          "legendFormat": "Miss P95 (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "type": "timeseries",
      "title": "Request Throughput (Hits vs Misses per Sec)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(llm_cache_requests_total{status=\"hit\"}[1m]))",
          "legendFormat": "Cache Hits / sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(llm_cache_requests_total{status=\"miss\"}[1m]))",
          "legendFormat": "Cache Misses / sec",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["llm", "cache", "roi"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Semantic Cache ROI Dashboard",
  "uid": "llm-semantic-cache-roi"
}
